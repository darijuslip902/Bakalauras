# Optional GitHub token. Do not commit the real token.
GITHUB_TOKEN=

# Local SQLite database path
DATABASE_PATH=data/bakalauras.sqlite3

# Maximum number of issues imported in one operation
GITHUB_IMPORT_LIMIT=100

# Katalogas su apmokytais modeliais (5C): category_label.joblib, complexity_label.joblib, priority_label.joblib
MODELS_DIR=models

# Per-field minimum labeled samples threshold; validation must also check class distribution.
MIN_TRAINING_SAMPLES=30

# --- Programuotojo prisijungimas (3 etapas) ---
# Tikrų reikšmių čia NERAŠYTI. Nukopijuok šį failą į .env ir ten įrašyk reikšmes,
# kurias sugeneruoja komanda: python -m app.auth
ADMIN_USERNAME=
# PBKDF2-SHA256 maišas (ne pats slaptažodis), pvz. pbkdf2_sha256:600000:...
ADMIN_PASSWORD_HASH=
# Atsitiktinis bent 32 simbolių raktas sesijos slapukui pasirašyti
SESSION_SECRET_KEY=
# true produkcinėje HTTPS aplinkoje; lokaliai per HTTP palikti tuščią
SESSION_COOKIE_SECURE=

# --- DI žymėjimas mokymo duomenims (5A etapas, tik python -m tools.ai_label) ---
# Anthropic API raktas (console.anthropic.com). Tikro rakto NERAŠYTI čia – tik į .env.
ANTHROPIC_API_KEY=
# Bendras visų DI žymėjimo paleidimų išlaidų limitas USD (skaičiuojamas iš DB)
AI_TOTAL_BUDGET_USD=10
